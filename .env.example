# Variáveis de ambiente do FinTrack (desenvolvimento).
# Copie para .env (que NUNCA vai para o Git) e troque o que está marcado com TROQUE.
#   cp .env.example .env
# O app (apps/web), o Prisma (packages/db) e os testes leem este mesmo arquivo.

# ── Banco de dados (container "db" do compose.yml) ──
DATABASE_URL="postgresql://fintrack:fintrack@localhost:5432/fintrack"

# ── Better Auth ──
# Segredo que assina os cookies e cifra o segredo do 2FA no banco. Gere com:
#   openssl rand -base64 32
# Se ele mudar, todas as sessões caem e os 2FA já ligados param de funcionar.
BETTER_AUTH_SECRET="TROQUE-pelo-resultado-do-openssl"
# Endereço pelo qual você abre o app. Os links dos e-mails usam este endereço.
BETTER_AUTH_URL="http://localhost:3000"
# Outros endereços aceitos (separados por vírgula), como o IP do servidor na rede de casa
BETTER_AUTH_TRUSTED_ORIGINS="http://192.168.1.92:3000"

# ── Cadastro fechado: só estes e-mails conseguem criar conta (separados por vírgula) ──
# Os dois @fintrack.test são das contas dos testes automáticos (não recebem e-mail de verdade).
# Em produção (M05), só os dois e-mails reais.
ALLOWED_EMAILS="TROQUE-seu-email@exemplo.com,TROQUE-email-da-esposa@exemplo.com,ana@fintrack.test,bruno@fintrack.test"

# ── E-mail (Mailpit do compose.yml: nada sai da sua máquina; veja em http://localhost:8025) ──
EMAIL_FROM="FinTrack <nao-responda@fintrack.local>"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""

# ── Passkeys: o domínio do app ("localhost" em desenvolvimento; o domínio real no M05) ──
PASSKEY_RP_ID="localhost"

# ── Senhas vazadas (Have I Been Pwned): deixe "on". O CI usa "off" para não depender da internet. ──
HIBP_CHECK="on"

# ── Login com Google (opcional; passo 18 do manual). Sem os dois, o botão não aparece. ──
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ── Log do servidor (JSON, pino): info (padrão), warn, error, debug. Nos testes, silencioso. ──
# LOG_LEVEL="info"

# ── Coleta bancária (M09.1): a chave que cifra o Client Secret do Meu Pluggy no banco ──
# Gere com: echo "1:$(openssl rand -base64 32)". Guarde uma cópia no gerenciador de senhas:
# sem ela, os segredos gravados não decifram mais (é só digitar o Client Secret de novo).
# Para trocar a chave: "2:<nova>,1:<antiga>" (a primeira cifra; todas decifram).
CONNECTION_SECRET_KEYS="TROQUE-pelo-resultado-do-echo"
# A fila da sincronização roda dentro do app (pg-boss). "off" desliga a busca diária e o botão.
# SYNC_WORKER="on"
# Endereço da API da Pluggy. Em casa, a Pluggy DE MENTIRA (banco sintético, finais 0001 a 0003):
# suba com "pnpm pluggy:fake" (o "pnpm e2e" sobe sozinho). Sem a variável, vale a Pluggy de
# verdade (https://api.pluggy.ai), que só a produção usa.
PLUGGY_API_URL="http://127.0.0.1:8787"

# ── Fatura em PDF (M09.4) e classificador de categorias (M10.1): o serviço Python (services/ml) ──
# Suba com "pnpm --filter @fintrack/ml dev" (o "pnpm e2e" sobe sozinho). Sem a variável, o PDF é
# recusado com um aviso e a cascata roda sem o classificador; o OFX continua funcionando.
ML_SERVICE_URL="http://127.0.0.1:8001"

# ── Bot do WhatsApp (M11): a Cloud API da Meta ──
# Em casa, a Cloud API DE MENTIRA (nada sai da sua máquina; números inventados): suba com
# "pnpm whatsapp:fake" (o "pnpm e2e" sobe sozinho). Os quatro valores abaixo são só do
# desenvolvimento e da Cloud API de mentira: os de verdade (painel da Meta, M11.2) vão SÓ para
# /srv/fintrack/app.env, com o fintrack-definir. Sem os quatro, o bot fica desligado.
WHATSAPP_API_URL="http://127.0.0.1:8789/v26.0"
WHATSAPP_APP_SECRET="segredo-do-app-de-mentira-0001"
WHATSAPP_ACCESS_TOKEN="token-de-mentira-0000000000000001"
WHATSAPP_VERIFY_TOKEN="verificacao-de-mentira-0001"
WHATSAPP_PHONE_NUMBER_ID="100000000000001"
# Como a tela mostra o número do bot, e se é o número de teste da Meta ("on") ou um próprio ("off")
WHATSAPP_DISPLAY_NUMBER="+1 555 010-0000"
WHATSAPP_TEST_NUMBER="on"

# ── Bot do Telegram (M12.0b): a Bot API ──
# Em casa, o Telegram DE MENTIRA (nada sai da sua máquina; conversas inventadas): suba com
# "pnpm telegram:fake" (o "pnpm e2e" sobe sozinho). Os valores abaixo são só do desenvolvimento e do
# Telegram de mentira: os de verdade (o token do @BotFather e um segredo seu) vão SÓ para
# /srv/fintrack/app.env, com o fintrack-definir. Sem os três primeiros, o Telegram fica desligado.
TELEGRAM_BOT_TOKEN="1000000001:token-de-mentira-do-telegram-000001"
TELEGRAM_WEBHOOK_SECRET="segredo-de-mentira-do-telegram-0000000001"
TELEGRAM_BOT_USERNAME="FinTrackExemploBot"
TELEGRAM_API_URL="http://127.0.0.1:8790"
