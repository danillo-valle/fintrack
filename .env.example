# Variáveis de ambiente do FinTrack (desenvolvimento).
# Copie para .env (que NUNCA vai para o Git) e troque o que está marcado com TROQUE.
#   cp .env.example .env
# O app (apps/web), o Prisma (packages/db) e os testes leem este mesmo arquivo.

# ── Banco de dados (container "db" do compose.yml) ──
DATABASE_URL="postgresql://fintrack:fintrack@localhost:5432/fintrack"

# ── Better Auth ──
# Segredo que assina os cookies e cifra o segredo do 2FA no banco. Gere com:
#   openssl rand -base64 32
# Se ele mudar, todas as sessões caem e os 2FA já ligados param de funcionar.
BETTER_AUTH_SECRET="TROQUE-pelo-resultado-do-openssl"
# Endereço pelo qual você abre o app. Os links dos e-mails usam este endereço.
BETTER_AUTH_URL="http://localhost:3000"
# Outros endereços aceitos (separados por vírgula), como o IP do servidor na rede de casa
BETTER_AUTH_TRUSTED_ORIGINS="http://192.168.1.92:3000"

# ── Cadastro fechado: só estes e-mails conseguem criar conta (separados por vírgula) ──
# Os dois @fintrack.test são das contas dos testes automáticos (não recebem e-mail de verdade).
# Em produção (M05), só os dois e-mails reais.
ALLOWED_EMAILS="TROQUE-seu-email@exemplo.com,TROQUE-email-da-esposa@exemplo.com,ana@fintrack.test,bruno@fintrack.test"

# ── E-mail (Mailpit do compose.yml: nada sai da sua máquina; veja em http://localhost:8025) ──
EMAIL_FROM="FinTrack <nao-responda@fintrack.local>"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""

# ── Passkeys: o domínio do app ("localhost" em desenvolvimento; o domínio real no M05) ──
PASSKEY_RP_ID="localhost"

# ── Senhas vazadas (Have I Been Pwned): deixe "on". O CI usa "off" para não depender da internet. ──
HIBP_CHECK="on"

# ── Login com Google (opcional; passo 18 do manual). Sem os dois, o botão não aparece. ──
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
