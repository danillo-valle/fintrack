{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "BETTER_AUTH_*",
    "ALLOWED_EMAILS",
    "EMAIL_FROM",
    "SMTP_*",
    "PASSKEY_RP_ID",
    "HIBP_CHECK",
    "GOOGLE_CLIENT_*",
    "MAILPIT_URL",
    "LOG_LEVEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate", "db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["APP_VERSION"]
    },
    "lint": {
      "dependsOn": ["^lint", "^db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^db:generate", "db:generate"]
    },
    "test": {
      "dependsOn": ["^test", "^db:generate", "db:generate"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^db:generate"]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["CI", "PLAYWRIGHT_*"],
      "dependsOn": ["^db:generate"]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "db:generate": {
      "inputs": ["prisma/schema/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    }
  }
}
