// ─────────────────────────────────────────────────────────────────────────────
// Lançamentos, faturas do cartão, compras parceladas e recorrências (M04)
//
//   Transaction        cada entrada ou saída de dinheiro. Responde três perguntas separadas:
//                        QUEM PAGA      accountId (+ cardId, opcional) e method
//                        DE QUEM É      walletId (o ambiente: "Casa", "Danillo"...)
//                        O QUE É        categoryId
//   CardStatement      fatura do cartão (competência ≠ caixa)
//   InstallmentGroup   compra parcelada → N lançamentos, um por fatura
//   Recurrence         conta fixa, assinatura ou receita que se repete todo mês; os
//                      lançamentos que ela gera apontam para ela (recurrenceId)
//
// "Despesa fixa", "variável", "recorrente" e "parcelada" (as abas da planilha) não são
// colunas: são CALCULADAS. Parcelada = tem installmentGroupId. Fixa, assinatura ou receita
// recorrente = tem recurrenceId (o tipo está na Recurrence). Variável = nenhuma das duas.
//
// Convenções do lançamento:
//   amount       com SINAL: negativo = saiu dinheiro, positivo = entrou. CHECK: nunca zero
//   occurredOn   DATE, sem hora: o dia em que aconteceu (ou vai acontecer, se SCHEDULED)
//   transferId   os dois lados de uma transferência (ou do pagamento da fatura) têm o mesmo
//                valor aqui; relatórios de gasto ignoram quem tem transferId
//   deletedAt    exclusão lógica: some das telas, mas o "desfazer" e a auditoria continuam
//
// Todas as ligações levam o householdId junto (chaves compostas): o banco garante que
// conta, ambiente, cartão, categoria e fatura de um lançamento são todos do mesmo grupo.
// ─────────────────────────────────────────────────────────────────────────────

/// PENDING: veio de fora (Open Finance, arquivo, bot) e espera revisão.
/// SCHEDULED: agendado, ainda não aconteceu (boleto agendado, conta fixa do mês).
/// CONFIRMED: aconteceu e foi conferido.
enum TransactionStatus {
  PENDING
  SCHEDULED
  CONFIRMED

  @@map("transaction_status")
}

/// De onde o lançamento veio. Junto com externalId, impede importar duas vezes.
enum TransactionSource {
  MANUAL
  OFX
  PDF
  OPEN_FINANCE
  BOT
  RECURRENCE

  @@map("transaction_source")
}

/// Como o dinheiro saiu ou entrou. CHECK: com cartão, só CREDIT, DEBIT ou VOUCHER.
enum PaymentMethod {
  CREDIT
  DEBIT
  PIX
  BOLETO
  TRANSFER
  DEPOSIT
  CASH
  WITHDRAWAL
  /// Vale-refeição ou vale-alimentação
  VOUCHER

  @@map("payment_method")
}

/// Situação da fatura do cartão. É daqui que vem o "PAGO/ABERTO" de uma compra no cartão.
enum StatementStatus {
  OPEN
  CLOSED
  PAID

  @@map("statement_status")
}

/// Quem decidiu a categoria de um lançamento (M07). A pessoa (MANUAL) ou a camada da cascata
/// cuja sugestão a pessoa aceitou sem mudar. Valores novos chegam por acréscimo: a categoria da
/// Pluggy no M09, o classificador e o LLM no M10 (ADR-007).
enum CategorizationSource {
  MANUAL
  /// Uma regra texto → categoria (CategoryRule)
  RULE
  /// A categoria mais usada pelo lar para o mesmo comerciante
  HISTORY
  /// A categoria que o banco mandou (Meu Pluggy), traduzida para a categoria do lar (M10.1)
  PROVIDER
  /// O classificador do serviço Python, com confiança de 80 % ou mais (M10.1, ADR-015)
  CLASSIFIER
  /// A IA local (M10.2b, ADR-016): o Qwen2.5 3B na janela da noite, só nos recebidos das cargas
  /// do banco e só depois de todas as outras camadas. Vale quando a pessoa confirma
  LLM

  @@map("categorization_source")
}

/// Tipo de recorrência: as antigas abas "Despesas Fixas" e "Despesas Recorrentes".
enum RecurrenceKind {
  /// Conta fixa: aluguel, condomínio, internet, consórcio, seguro
  FIXED_BILL
  /// Assinatura: streaming, academia, software (normalmente num cartão virtual)
  SUBSCRIPTION
  /// Receita que se repete: salário, aluguel recebido
  INCOME

  @@map("recurrence_kind")
}

/// Um lançamento: dinheiro que entrou ou saiu de uma conta, atribuído a um ambiente.
model Transaction {
  id                        String                @id @default(uuid(7)) @db.Uuid
  householdId               String                @db.Uuid
  /// DE QUEM é: o ambiente onde o lançamento conta ("Casa", "Danillo")
  walletId                  String                @db.Uuid
  /// QUEM PAGA: a conta (corrente, fatura do cartão, vale...)
  accountId                 String                @db.Uuid
  /// Com qual cartão daquela conta (opcional: PIX e transferência não têm cartão)
  cardId                    String?               @db.Uuid
  method                    PaymentMethod
  categoryId                String?               @db.Uuid
  /// Quem decidiu a categoria (M07). Opcional: os lançamentos antigos e os sem categoria ficam
  /// nulos. CHECK: só existe junto com categoryId
  categorizedBy             CategorizationSource?
  /// A confiança (0 a 100) da camada que decidiu (M10.1): regra = 100, histórico e banco = % dos
  /// votos, classificador = a probabilidade. CHECK: só com uma camada automática (nunca MANUAL)
  categorizationConfidence  Int?                  @db.SmallInt
  /// Valor com sinal, em reais com 2 casas (NUMERIC(14,2)). CHECK: diferente de zero
  amount                    Decimal               @db.Decimal(14, 2)
  /// Dia do lançamento (coluna DATE)
  occurredOn                DateTime              @db.Date
  /// O texto da origem: o do banco, do OFX ou do PDF, ou o que a pessoa digitou (manual). É dele que a
  /// categorização e a busca do banco leem. CHECK: de 1 a 200 caracteres
  description               String
  /// "O que foi" (M13.2): o nome que a pessoa dá a um lançamento do banco ("Sapato da Zara"),
  /// mostrado em destaque com a descrição do banco embaixo. Nunca treina a categorização nem vai
  /// para log. CHECK: de 1 a 200 caracteres (como a descrição)
  label                     String?
  notes                     String?
  status                    TransactionStatus     @default(CONFIRMED)
  source                    TransactionSource     @default(MANUAL)
  /// Id do lançamento na origem (FITID do OFX, id da Pluggy, ocorrência da recorrência).
  /// CHECK: obrigatório fora do MANUAL
  externalId                String?
  /// Fatura em que a compra entrou (só cartão de crédito)
  statementId               String?               @db.Uuid
  installmentGroupId        String?               @db.Uuid
  /// 1, 2, 3... CHECK: preenchido junto com installmentGroupId, nunca sozinho
  installmentNumber         Int?                  @db.SmallInt
  /// Recorrência que gerou este lançamento (conta fixa, assinatura, salário)
  recurrenceId              String?               @db.Uuid
  transferId                String?               @db.Uuid
  /// Transferência de um lado só (M13.2): o outro lado é de outra pessoa do lar ou de uma conta fora
  /// do FinTrack. CHECK: só com transferId
  transferPeer              TransferPeer?
  /// Estorno: aponta para a compra estornada
  reversalOfId              String?               @db.Uuid
  /// Compra em outra moeda (M09.1): o valor e a moeda originais; `amount` fica em reais.
  /// CHECK: os dois juntos ou nenhum; moeda com 3 letras maiúsculas
  originalAmount            Decimal?              @db.Decimal(14, 2)
  originalCurrency          String?               @db.Char(3)
  /// A categoria que o banco devolve (M09.1, texto da Pluggy). Vira camada da cascata no M09.2.
  /// CHECK: de 1 a 100 caracteres
  providerCategory          String?
  /// Parcela como o banco informa ("3 de 6"), enquanto a compra não é ligada a uma compra
  /// parcelada do FinTrack (M09.2). CHECK: os dois juntos, 1 <= número <= total, total de 2 a 99
  providerInstallmentNumber Int?                  @db.SmallInt
  providerInstallmentCount  Int?                  @db.SmallInt
  /// O final do cartão que o banco mandou (M09.2), mesmo quando ele não está cadastrado (um
  /// adicional novo): é por ele que a compra muda de cartão quando a pessoa cadastra o final.
  /// CHECK: 4 dígitos
  providerCardLastFour      String?               @db.Char(4)
  /// Revisão (M09.2): quando e por quem o recebido foi conferido (PENDING → CONFIRMED)
  reviewedAt                DateTime?
  reviewedById              String?
  /// Par (M09.2): o seu lançamento juntado ao recebido do banco aponta para ele e fica apagado
  /// (deletedAt). "Desfazer" volta os dois. CHECK: só junto com deletedAt
  mergedIntoId              String?               @db.Uuid
  /// O arquivo (OFX, M09.3; PDF da fatura, M09.4) de onde a linha veio. Só com source OFX ou PDF
  fileImportId              String?               @db.Uuid
  /// Quem lançou (nulo para o que veio de importação ou recorrência)
  createdById               String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  deletedAt                 DateTime?

  household              Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  // Chaves COMPOSTAS: cada par precisa existir junto na outra tabela. Um lançamento com o
  // ambiente de um grupo e a conta de outro é recusado pelo próprio banco.
  wallet                 Wallet                  @relation(fields: [walletId, householdId], references: [id, householdId], onDelete: Cascade)
  account                FinancialAccount        @relation(fields: [accountId, householdId], references: [id, householdId], onDelete: Cascade)
  // NoAction nas opcionais compostas: SetNull zeraria também o accountId/householdId
  // (obrigatórios). Cartão e categoria em uso são arquivados, não apagados.
  card                   PaymentCard?            @relation(fields: [cardId, accountId], references: [id, accountId], onDelete: NoAction)
  category               Category?               @relation(fields: [categoryId, householdId], references: [id, householdId], onDelete: NoAction)
  statement              CardStatement?          @relation(fields: [statementId, accountId], references: [id, accountId], onDelete: NoAction)
  installmentGroup       InstallmentGroup?       @relation(fields: [installmentGroupId, accountId], references: [id, accountId], onDelete: Cascade)
  recurrence             Recurrence?             @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  reversalOf             Transaction?            @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals              Transaction[]           @relation("Reversal")
  createdBy              User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy             User?                   @relation("TransactionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  mergedInto             Transaction?            @relation("Merge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom             Transaction[]           @relation("Merge")
  // Composta e NoAction: o registro do arquivo importado nunca é apagado
  fileImport             FileImport?             @relation(fields: [fileImportId, householdId], references: [id, householdId], onDelete: NoAction)
  /// O que a IA local respondeu sobre este recebido (M10.2b): no máximo uma vez
  localAiAttempt         LocalAiAttempt?
  matchesAsReceived      TransactionMatch[]      @relation("MatchReceived")
  matchesAsOwn           TransactionMatch[]      @relation("MatchOwn")
  categorizationExamples CategorizationExample[]
  /// A proposta do bot que virou este lançamento (M11)
  botDrafts              BotDraft[]

  // Idempotência da importação: o mesmo lançamento da mesma origem na mesma conta, uma vez só.
  // Lançamentos manuais têm externalId nulo, e no Postgres nulos não colidem entre si.
  @@unique([accountId, source, externalId])
  // A parcela 3 de uma compra existe uma vez só
  @@unique([installmentGroupId, installmentNumber])
  // A consulta mais comum: "os lançamentos deste ambiente, do mais recente para o mais antigo"
  @@index([walletId, occurredOn(sort: Desc)])
  @@index([accountId, occurredOn])
  @@index([cardId])
  @@index([statementId])
  @@index([categoryId])
  @@index([recurrenceId])
  @@index([transferId])
  @@index([mergedIntoId])
  @@index([reversalOfId])
  @@index([fileImportId])
  @@map("transaction")
}

/// O tipo de um par da revisão (M09.2, ADR-012).
/// O outro lado de uma transferência marcada só de um lado (M13.2).
enum TransferPeer {
  /// Uma conta de outra pessoa do lar (que quem marca não vê)
  HOUSEHOLD
  /// Uma conta da pessoa fora do FinTrack
  EXTERNAL

  @@map("transfer_peer")
}

enum MatchKind {
  /// O mesmo gasto: mesmo valor, datas a até 5 dias
  SAME
  /// A parcela do banco ("3 de 6") com a parcela da compra parcelada do FinTrack
  INSTALLMENT
  /// Um crédito do banco que estorna uma compra anterior (reversalOfId)
  REFUND
  /// Os dois lados de uma transferência entre contas (M13.2): a saída de uma e a entrada na outra,
  /// ligados pelo mesmo transferId. O pagamento da fatura é a transferência que entra no cartão
  TRANSFER

  @@map("match_kind")
}

/// A decisão da pessoa sobre um par.
enum MatchStatus {
  /// Juntou (ou ligou o estorno)
  CONFIRMED
  /// "Não é o mesmo": a sugestão não volta
  REJECTED
  /// Juntou e desfez
  UNDONE

  @@map("match_status")
}

/// Uma decisão da revisão sobre um par recebido × seu lançamento (M09.2). As sugestões são
/// calculadas na hora (packages/core/src/reconcile.ts); aqui fica só o que a pessoa decidiu, e o
/// estado de antes, para o "Desfazer". Um par por recebido é garantido pela própria operação: ela
/// só junta um recebido ainda PENDING e um lançamento seu ainda não apagado (UPDATE condicional).
/// CHECK: os dois lados são lançamentos diferentes; UNDONE anda junto com undoneAt
model TransactionMatch {
  id             String      @id @default(uuid(7)) @db.Uuid
  householdId    String      @db.Uuid
  receivedId     String      @db.Uuid
  ownId          String      @db.Uuid
  kind           MatchKind
  status         MatchStatus
  /// Os campos do recebido e do seu lançamento antes de juntar (para o "Desfazer")
  receivedBefore Json?
  ownBefore      Json?
  decidedById    String?
  decidedAt      DateTime    @default(now())
  undoneAt       DateTime?

  household Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  received  Transaction @relation("MatchReceived", fields: [receivedId], references: [id], onDelete: Cascade)
  own       Transaction @relation("MatchOwn", fields: [ownId], references: [id], onDelete: Cascade)
  decidedBy User?       @relation(fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([receivedId])
  @@index([ownId])
  @@index([householdId, decidedAt(sort: Desc)])
  @@map("transaction_match")
}

/// Fatura do cartão: guarda a competência (mês de referência) e o caixa (vencimento).
model CardStatement {
  id             String            @id @default(uuid(7)) @db.Uuid
  accountId      String            @db.Uuid
  /// Mês da fatura, guardado como o dia 1. CHECK: sempre dia 1
  referenceMonth DateTime          @db.Date
  closingDate    DateTime          @db.Date
  /// CHECK: depois do fechamento
  dueDate        DateTime          @db.Date
  /// Valor da fatura (positivo = a pagar). Nulo enquanto a fatura está aberta
  total          Decimal?          @db.Decimal(14, 2)
  minimumPayment Decimal?          @db.Decimal(14, 2)
  status         StatementStatus   @default(OPEN)
  source         TransactionSource @default(MANUAL)
  externalId     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  account      FinancialAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  charges      StatementCharge[]
  payments     StatementPayment[]
  /// Os PDFs da fatura que entraram nela (M09.4)
  fileImports  FileImport[]

  // Alvo da chave composta (statementId, accountId): a compra está na fatura da própria conta
  @@unique([id, accountId])
  @@unique([accountId, referenceMonth])
  @@map("card_statement")
}

/// Tipo de encargo da fatura, como o Open Finance informa (M09.1).
enum StatementChargeKind {
  IOF
  /// Juros de mora
  LATE_INTEREST
  /// Multa por atraso
  LATE_FEE
  /// Juros remuneratórios (rotativo)
  REMUNERATIVE_INTEREST
  OTHER

  @@map("statement_charge_kind")
}

/// Encargo de uma fatura vinda do banco: IOF, juros, multa (M09.1). Regravados a cada busca.
model StatementCharge {
  id          String              @id @default(uuid(7)) @db.Uuid
  statementId String              @db.Uuid
  accountId   String              @db.Uuid
  kind        StatementChargeKind
  /// Valor do encargo (positivo = a pagar). CHECK: maior ou igual a zero
  amount      Decimal             @db.Decimal(14, 2)
  createdAt   DateTime            @default(now())

  // Composta: o encargo é da fatura daquela conta
  statement CardStatement    @relation(fields: [statementId, accountId], references: [id, accountId], onDelete: Cascade)
  account   FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([statementId])
  @@index([accountId])
  @@map("statement_charge")
}

/// Pagamento de uma fatura, como o banco informa (M09.1). Regravados a cada busca.
model StatementPayment {
  id          String   @id @default(uuid(7)) @db.Uuid
  statementId String   @db.Uuid
  accountId   String   @db.Uuid
  paidOn      DateTime @db.Date
  /// Valor pago. CHECK: maior que zero
  amount      Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())

  statement CardStatement    @relation(fields: [statementId, accountId], references: [id, accountId], onDelete: Cascade)
  account   FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([statementId])
  @@index([accountId])
  @@map("statement_payment")
}

/// Compra parcelada: a compra original, de onde saem os lançamentos de cada parcela.
model InstallmentGroup {
  id               String   @id @default(uuid(7)) @db.Uuid
  householdId      String   @db.Uuid
  walletId         String   @db.Uuid
  accountId        String   @db.Uuid
  description      String
  /// Valor total da compra, com sinal. CHECK: diferente de zero
  totalAmount      Decimal  @db.Decimal(14, 2)
  /// CHECK: de 2 a 99 parcelas
  installmentCount Int      @db.SmallInt
  purchasedOn      DateTime @db.Date
  createdAt        DateTime @default(now())

  household    Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  wallet       Wallet           @relation(fields: [walletId, householdId], references: [id, householdId], onDelete: Cascade)
  account      FinancialAccount @relation(fields: [accountId, householdId], references: [id, householdId], onDelete: Cascade)
  transactions Transaction[]
  /// A proposta do bot que virou esta compra parcelada (M11)
  botDrafts    BotDraft[]

  // Alvo da chave composta (installmentGroupId, accountId): as parcelas ficam na mesma conta
  @@unique([id, accountId])
  @@index([accountId])
  @@map("installment_group")
}

/// Recorrência: um lançamento que se repete todo mês no mesmo dia (conta fixa, assinatura,
/// salário). No M07, ela gera os lançamentos do mês como SCHEDULED, que viram CONFIRMED.
model Recurrence {
  id          String         @id @default(uuid(7)) @db.Uuid
  householdId String         @db.Uuid
  walletId    String         @db.Uuid
  accountId   String         @db.Uuid
  cardId      String?        @db.Uuid
  categoryId  String?        @db.Uuid
  kind        RecurrenceKind
  method      PaymentMethod
  description String
  /// Valor previsto, com sinal (contas variáveis, como a de luz, usam a média). CHECK: ≠ zero
  amount      Decimal        @db.Decimal(14, 2)
  /// Dia do mês (1 a 31; num mês mais curto, cai no último dia). CHECK: de 1 a 31
  dayOfMonth  Int            @db.SmallInt
  startsOn    DateTime       @db.Date
  /// Nulo = sem prazo. CHECK: depois do início
  endsOn      DateTime?      @db.Date
  createdById String?
  archivedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  household    Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  wallet       Wallet           @relation(fields: [walletId, householdId], references: [id, householdId], onDelete: Cascade)
  account      FinancialAccount @relation(fields: [accountId, householdId], references: [id, householdId], onDelete: Cascade)
  card         PaymentCard?     @relation(fields: [cardId, accountId], references: [id, accountId], onDelete: NoAction)
  category     Category?        @relation(fields: [categoryId, householdId], references: [id, householdId], onDelete: NoAction)
  createdBy    User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([householdId])
  @@index([walletId])
  @@map("recurrence")
}

/// O modelo do classificador de uma carteira (M10.1, ADR-015). O modelo em si fica no volume do
/// serviço Python (nunca no banco, no Git ou numa imagem); aqui fica só o que a tela mostra e
/// a impressão digital do que foi usado no treino, para não treinar de novo sem mudança.
model ClassifierModel {
  id            String   @id @default(uuid(7)) @db.Uuid
  householdId   String   @db.Uuid
  /// Um modelo por carteira: só quem vê a carteira pergunta a ele (o mesmo cuidado do histórico)
  walletId      String   @unique @db.Uuid
  trainedAt     DateTime
  /// Quantos lançamentos e quantas categorias entraram no treino. CHECK: >= 20 e >= 2
  exampleCount  Int
  categoryCount Int      @db.SmallInt
  /// SHA-256 (hex) dos exemplos do treino: igual ao da noite anterior = nada a treinar
  trainingHash  String   @db.Char(64)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  wallet    Wallet    @relation(fields: [walletId, householdId], references: [id, householdId], onDelete: Cascade)

  @@index([householdId])
  @@map("classifier_model")
}

/// O que a IA local respondeu sobre um recebido (M10.2b, ADR-016).
enum LocalAiOutcome {
  /// Escolheu uma categoria da lista: ela foi gravada no recebido (categorizedBy LLM)
  SUGGESTED
  /// Propôs uma categoria nova (nome e mãe): fica esperando o "Criar e aplicar" da pessoa
  NEW_CATEGORY
  /// Respondeu "nenhuma": não dá para saber
  NO_SUGGESTION
  /// O filtro barrou (a descrição tinha cara de instrução): nem foi ao modelo
  BLOCKED
  /// A resposta saiu do schema (descartada)
  INVALID

  @@map("local_ai_outcome")
}

/// Uma linha por recebido que a IA local já viu (M10.2b, ADR-016): é o que tira o recebido da
/// fila ("Na fila da IA" = recebido de carga, sem categoria e SEM linha aqui) e o que a tela de
/// Ajustes conta da última noite. A descrição nunca é guardada aqui: ela já está no lançamento.
model LocalAiAttempt {
  transactionId    String         @id @db.Uuid
  householdId      String         @db.Uuid
  outcome          LocalAiOutcome
  /// A categoria nova proposta (só NEW_CATEGORY). CHECK: de 2 a 30 caracteres, só letras e
  /// espaços (o mesmo padrão que o schema da IA impõe)
  proposedName     String?
  /// A mãe da categoria nova (só NEW_CATEGORY; nula = primeiro nível)
  proposedParentId String?        @db.Uuid
  attemptedAt      DateTime       @default(now())

  household      Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  // Composta e NoAction: a mãe é do mesmo lar; categoria é arquivada, nunca apagada
  proposedParent Category?   @relation("LocalAiProposedParent", fields: [proposedParentId, householdId], references: [id, householdId], onDelete: NoAction)

  @@index([householdId, attemptedAt])
  @@map("local_ai_attempt")
}
