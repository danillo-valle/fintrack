// ─────────────────────────────────────────────────────────────────────────────
// Conexões com bancos, sincronizações e trilha de auditoria (M04; usadas no M06 e no M09)
//
//   User ── ProviderConnection ── SyncRun        cada execução da sincronização, auditável
//                              ├─ ProviderItem   cada banco conectado no Meu Pluggy (M09.1)
//                              └─ FinancialAccount (connectionId + externalId) a conta ligada
//   FinancialAccount ── AccountBalance           o último saldo e limite que o banco informou
//   AuditLog                                     quem fez o quê, quando e de onde (só acrescenta)
//   FileImport ── Transaction (fileImportId)     um extrato enviado pela pessoa (OFX, M09.3)
//
// M09.1 (ADR-011): o Client Secret fica CIFRADO (AES-256-GCM) com a chave fora do banco, na
// variável CONNECTION_SECRET_KEYS; tudo que o banco manda entra como lançamento PENDING
// ("recebido"), fora das somas até a revisão.
//
// M09.3 (ADR-013): o arquivo OFX é lido na memória e DESCARTADO. Fica a impressão digital
// (SHA-256), para avisar "este arquivo já foi importado", e um resumo (banco, final, período,
// contagens). As linhas lidas ficam só enquanto a pessoa confere (1 hora), e saem ao importar.
// ─────────────────────────────────────────────────────────────────────────────

/// Provedor de dados bancários. Por enquanto, só o Meu Pluggy (Open Finance, M09).
enum ProviderKind {
  PLUGGY

  @@map("provider_kind")
}

enum ConnectionStatus {
  ACTIVE
  ERROR
  REVOKED

  @@map("connection_status")
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  FAILED

  @@map("sync_status")
}

/// Quem pediu a sincronização (M09.1): a agenda diária ou o botão "Buscar agora".
enum SyncTrigger {
  SCHEDULED
  MANUAL

  @@map("sync_trigger")
}

/// Conexão de uma pessoa com o provedor. Cada cônjuge conecta só as próprias contas.
model ProviderConnection {
  id               String           @id @default(uuid(7)) @db.Uuid
  /// O titular das contas conectadas
  userId           String
  /// Carteira onde os lançamentos importados entram
  walletId         String           @db.Uuid
  provider         ProviderKind
  status           ConnectionStatus @default(ACTIVE)
  clientId         String?
  /// Client Secret CIFRADO (M09), com a chave fora do banco. Nunca texto claro, nunca em log.
  /// Formato (M09.1): versão da chave (1 byte) + IV (12) + etiqueta GCM (16) + texto cifrado
  secretCiphertext Bytes?
  /// Data de corte (M09.1): nada do banco antes deste dia entra no FinTrack (os lançamentos
  /// manuais antigos ficam como estão e não duplicam). Nulo até a pessoa ligar as contas
  importFrom       DateTime?        @db.Date
  lastSyncedAt     DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet   Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  accounts FinancialAccount[]
  runs     SyncRun[]
  items    ProviderItem[]

  // Uma conexão por pessoa e provedor (M09.1): cada cônjuge tem o próprio Meu Pluggy
  @@unique([userId, provider])
  @@index([userId])
  @@index([walletId])
  @@map("provider_connection")
}

/// Um banco conectado no Meu Pluggy (M09.1). A pessoa copia o Item ID do painel da Pluggy: para
/// contas do Meu Pluggy, a API não lista os items sozinha. Até 5 por conexão (regra do app).
model ProviderItem {
  id            String    @id @default(uuid(7)) @db.Uuid
  connectionId  String    @db.Uuid
  /// O Item ID na Pluggy. CHECK: de 8 a 64 caracteres, só letras, números e hífen
  externalId    String
  /// Nome do banco, como a Pluggy informa ("Banco Aurora"); nulo até a primeira busca
  institution   String?
  /// Quando o Meu Pluggy atualizou este banco pela última vez (ele atualiza 1 vez por dia)
  bankUpdatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@map("provider_item")
}

/// Uma execução da sincronização: começou, terminou, quantos itens, qual erro.
model SyncRun {
  id             String      @id @default(uuid(7)) @db.Uuid
  connectionId   String      @db.Uuid
  startedAt      DateTime    @default(now())
  /// CHECK: nulo enquanto RUNNING; depois, igual ou posterior ao início
  finishedAt     DateTime?
  status         SyncStatus  @default(RUNNING)
  itemsCreated   Int         @default(0)
  itemsUpdated   Int         @default(0)
  /// Agenda diária ou botão "Buscar agora" (M09.1)
  trigger        SyncTrigger @default(SCHEDULED)
  /// Quem apertou o botão (nulo na agenda). Sem chave estrangeira: o histórico sobrevive à conta
  requestedById  String?
  /// Lançamentos que o banco mandou de novo sem nenhuma mudança (M09.1). CHECK: maior ou igual a 0
  itemsUnchanged Int         @default(0)
  /// Lançamentos que não puderam entrar (compra em outra moeda sem o valor em reais). CHECK: >= 0
  itemsSkipped   Int         @default(0)
  /// O código do erro (PROVIDER_AUTH_FAILED, PROVIDER_UNAVAILABLE...), nunca a resposta crua do
  /// provedor: ela pode trazer dado pessoal. A tela traduz o código
  error          String?

  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt(sort: Desc)])
  @@map("sync_run")
}

/// O último saldo e limite que o banco informou para uma conta ligada (M09.1). Uma linha por
/// conta, sobrescrita a cada busca: é o que o Início mostra em "Contas e cartões".
model AccountBalance {
  accountId       String    @id @db.Uuid
  /// Saldo da conta corrente ou poupança (com sinal). Nulo em cartão
  balance         Decimal?  @db.Decimal(14, 2)
  /// Limite total e disponível do cartão. CHECK: maiores ou iguais a zero
  creditLimit     Decimal?  @db.Decimal(14, 2)
  availableCredit Decimal?  @db.Decimal(14, 2)
  /// Fechamento e vencimento da fatura aberta, como o banco informa
  closeDate       DateTime? @db.Date
  dueDate         DateTime? @db.Date
  /// Moeda da conta. CHECK: 3 letras maiúsculas (ISO 4217)
  currency        String    @default("BRL") @db.Char(3)
  /// Quando o FinTrack leu estes números do banco
  asOf            DateTime

  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("account_balance")
}

/// Trilha de auditoria (OWASP A09:2025). SÓ ACRESCENTA: um gatilho no banco recusa UPDATE e
/// DELETE (veja a migração). Sem chaves estrangeiras de propósito: o registro de que alguém
/// fez algo precisa sobreviver mesmo que a conta ou a casa sejam apagadas.
model AuditLog {
  /// Número sequencial: a ordem dos eventos fica explícita
  id          BigInt   @id @default(autoincrement())
  createdAt   DateTime @default(now())
  /// Quem fez (id do usuário); nulo para ações do sistema (sincronização agendada)
  actorId     String?
  householdId String?  @db.Uuid
  /// O que aconteceu, no formato entidade.verbo: "wallet.member_invited", "transactions.exported"
  action      String
  entity      String
  entityId    String?
  ipAddress   String?
  userAgent   String?
  /// Detalhes da ação. Nunca guarde aqui senha, token, segredo ou dado de cartão.
  metadata    Json?

  @@index([householdId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_log")
}

/// O tipo de arquivo enviado (M09.3: OFX; o PDF da fatura vem no M09.4).
enum FileImportKind {
  OFX

  @@map("file_import_kind")
}

/// PREVIEW = a pessoa está conferindo (some ao cancelar ou depois de 1 hora); IMPORTED = entrou.
enum FileImportStatus {
  PREVIEW
  IMPORTED

  @@map("file_import_status")
}

/// Extrato de conta (corrente ou poupança) ou fatura de cartão.
enum FileStatementKind {
  BANK
  CREDIT_CARD

  @@map("file_statement_kind")
}

/// Um extrato enviado pela pessoa (M09.3, ADR-013). NUNCA o arquivo: só a impressão digital e
/// um resumo. As linhas lidas (`preview`) existem só enquanto PREVIEW.
model FileImport {
  id                   String            @id @default(uuid(7)) @db.Uuid
  householdId          String            @db.Uuid
  /// Quem enviou (nulo se a pessoa sair do FinTrack: o histórico fica)
  userId               String?
  /// A conta em que entrou. CHECK: obrigatória quando IMPORTED
  accountId            String?           @db.Uuid
  kind                 FileImportKind
  status               FileImportStatus  @default(PREVIEW)
  /// SHA-256 do arquivo, em hexadecimal. CHECK: 64 caracteres de 0-9 e a-f
  sha256               String            @db.Char(64)
  /// Nome do arquivo, como a pessoa mandou. CHECK: de 1 a 120 caracteres
  fileName             String
  statementKind        FileStatementKind
  /// Nome do banco, como o arquivo traz
  institution          String?
  /// Código do banco (BANKID, só extrato de conta): com o final, ensina a conta da próxima vez
  bankId               String?
  /// Os 4 últimos dígitos da conta ou do cartão. CHECK: 4 dígitos. Nunca o número inteiro
  accountLastFour      String?           @db.Char(4)
  periodFrom           DateTime?         @db.Date
  periodTo             DateTime?         @db.Date
  /// Lançamentos lidos no arquivo, e o que foi feito com eles. CHECK: todos >= 0
  rowCount             Int
  createdCount         Int               @default(0)
  pluggyCount          Int               @default(0)
  alreadyImportedCount Int               @default(0)
  /// Linhas que não viram lançamento (o pagamento da fatura no extrato do cartão)
  skippedCount         Int               @default(0)
  /// As linhas lidas, enquanto a pessoa confere. CHECK: nulo quando IMPORTED
  preview              Json?
  /// Até quando a conferência vale (1 hora); depois disso a linha é apagada
  expiresAt            DateTime
  createdAt            DateTime          @default(now())
  /// CHECK: preenchido se, e só se, IMPORTED
  importedAt           DateTime?

  household    Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Composta e NoAction (regra 7 da skill): conta em uso é arquivada, não apagada
  account      FinancialAccount? @relation(fields: [accountId, householdId], references: [id, householdId], onDelete: NoAction)
  transactions Transaction[]

  // Alvo da chave composta do lançamento
  @@unique([id, householdId])
  // "Este arquivo já foi importado?"
  @@index([householdId, sha256])
  @@index([householdId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([accountId])
  @@map("file_import")
}
