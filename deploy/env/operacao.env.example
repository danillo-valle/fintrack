# /srv/fintrack/operacao.env : configurações dos scripts de operação (deploy/bin).
# Nada aqui dá acesso aos dados; mesmo assim fica com permissão 600 e fora do Git.

# Quantas versões antigas das imagens manter no servidor (para voltar rápido sem baixar)
KEEP_IMAGES=3

# Backups locais (pasta /srv/fintrack/backups): quantos diários e quantos "antes do deploy"
KEEP_DAILY=14
KEEP_PREDEPLOY=5

# Cópia fora de casa (Google Drive pelo rclone). Deixe vazio para só backup local.
# O nome antes dos dois pontos é o "remote" que você criou no "rclone config".
RCLONE_REMOTE="gdrive-fintrack:fintrack-backups"
# Quantos dias os backups ficam no Drive
REMOTE_RETENTION_DAYS=30

# Healthchecks.io: um endereço de ping por verificação (deixe vazio para desligar)
#   backup diário: avisa se o backup das 03:30 não rodar ou falhar
HC_BACKUP_URL=""
#   deploy: avisa na hora quando um deploy falha e o servidor volta para a versão anterior
HC_DEPLOY_URL=""
