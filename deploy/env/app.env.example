# /srv/fintrack/app.env : variáveis do app em PRODUÇÃO (container "web").
# Mesmas variáveis do .env de desenvolvimento (validadas por apps/web/src/lib/env.ts), com
# valores de produção. Modelo versionado SEM valores reais; a cópia de verdade fica só no
# servidor, com permissão 600. O DATABASE_URL não está aqui: o compose monta com a senha do .env.

# Endereço público do app (o subdomínio que você ligou ao túnel). Os links dos e-mails usam este.
BETTER_AUTH_URL="https://fintrack.TROQUE-seudominio.com.br"
# Sem outros endereços em produção (o IP de casa é só do desenvolvimento)
BETTER_AUTH_TRUSTED_ORIGINS=""

# Segredo NOVO, diferente do de desenvolvimento. Gere com:  openssl rand -base64 32
# Se ele mudar, todas as sessões caem e os 2FA já ligados param de funcionar.
BETTER_AUTH_SECRET="TROQUE-pelo-resultado-do-openssl-rand-base64-32"

# Só os e-mails de verdade de vocês dois (as contas @fintrack.test são só dos testes)
ALLOWED_EMAILS="TROQUE-seu-email@exemplo.com,TROQUE-email-da-esposa@exemplo.com"

# ── E-mail pelo Resend (grátis: 3.000/mês, 100/dia), com o seu domínio verificado ──
EMAIL_FROM="FinTrack <nao-responda@TROQUE-seudominio.com.br>"
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="resend"
# A chave da API do Resend, com permissão "Sending access" e só para o seu domínio
SMTP_PASSWORD="TROQUE-pela-chave-re_..."

# Passkeys: o domínio exato do app, sem https:// (as passkeys de desenvolvimento não valem aqui)
PASSKEY_RP_ID="fintrack.TROQUE-seudominio.com.br"

# Senhas vazadas: sempre ligado em produção
HIBP_CHECK="on"

# Nível do log JSON: info (padrão), warn para menos linhas, debug só para investigar algo
LOG_LEVEL="info"

# Login com Google (opcional): crie um cliente OAuth de PRODUÇÃO com a URI de retorno
#   https://fintrack.seudominio.com.br/api/auth/callback/google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
