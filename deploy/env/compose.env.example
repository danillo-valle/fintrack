# /srv/fintrack/.env : variáveis que o docker compose de produção usa (deploy/compose.prod.yml).
# Modelo versionado e SEM valores reais. A cópia de verdade fica só no servidor, com permissão
# 600 (só o usuário fintrack lê). Nunca vai para o Git, nem para o chat, nem para print.

# Senha do banco de produção. Gere com:  openssl rand -hex 32
# (hex: só letras e números, então não quebra o DATABASE_URL que o compose monta com ela)
# Trocar depois exige trocar no Postgres também (runbook: "Trocar a senha do banco").
POSTGRES_PASSWORD="TROQUE-pelo-resultado-do-openssl-rand-hex-32"

# Token do Cloudflare Tunnel: Zero Trust → Networks → Tunnels → seu túnel → "Install and run a
# connector" → Docker. É o texto longo depois de "--token". Quem tiver este token consegue
# publicar sites no seu domínio: trate como senha.
TUNNEL_TOKEN="TROQUE-pelo-token-do-tunel"
