# Backup diário do banco de produção (deploy/bin/fintrack-backup): cifrado com age, guardado em
# /srv/fintrack/backups e copiado para o Google Drive. Ver o histórico:
#   journalctl -u fintrack-backup --since "7 days ago"
[Unit]
Description=FinTrack: backup diário cifrado do banco
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=fintrack
Group=fintrack
Environment=FINTRACK_HOME=/srv/fintrack
ExecStart=/srv/fintrack/repo/deploy/bin/fintrack-backup diario
TimeoutStartSec=30min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
