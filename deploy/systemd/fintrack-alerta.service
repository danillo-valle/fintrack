# Alerta dos eventos de segurança (deploy/bin/fintrack-alerta, M12.4): conta os eventos dos
# últimos 15 minutos no log do app e avisa o Healthchecks.io (que manda o e-mail). Histórico:
#   journalctl -u fintrack-alerta --since "1 day ago"
[Unit]
Description=FinTrack: alerta dos eventos de segurança
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=fintrack
Group=fintrack
Environment=FINTRACK_HOME=/srv/fintrack
ExecStart=/srv/fintrack/repo/deploy/bin/fintrack-alerta
TimeoutStartSec=5min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
