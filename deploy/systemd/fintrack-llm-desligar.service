# Desliga a IA local no fim da janela da noite (deploy/bin/fintrack-llm desligar, M10.2b).
# Ver o histórico:  journalctl -u fintrack-llm-desligar --since "7 days ago"
[Unit]
Description=FinTrack: desliga a IA local (fim da janela da noite)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=fintrack
Group=fintrack
Environment=FINTRACK_HOME=/srv/fintrack
ExecStart=/srv/fintrack/repo/deploy/bin/fintrack-llm desligar
TimeoutStartSec=5min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
