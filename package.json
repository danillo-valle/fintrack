{
  "name": "fintrack",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "turbo run test:e2e",
    "db:up": "docker compose up -d --wait",
    "db:generate": "pnpm --filter @fintrack/db db:generate",
    "db:migrate": "pnpm --filter @fintrack/db db:migrate",
    "db:deploy": "pnpm --filter @fintrack/db db:deploy",
    "db:studio": "pnpm --filter @fintrack/db db:studio",
    "test:integration": "turbo run test:integration",
    "db:seed": "pnpm --filter @fintrack/db db:seed",
    "db:reset": "pnpm --filter @fintrack/db db:reset"
  },
  "packageManager": "pnpm@12.8.1",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "lefthook": "^2.1.15",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.5"
  }
}
